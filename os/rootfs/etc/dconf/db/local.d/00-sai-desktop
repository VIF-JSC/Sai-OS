# Sai system-wide desktop defaults (users can still change them).
# After editing run `dconf update`; the builder does this automatically.

[org/cinnamon]
# One 48 px panel at the bottom of the screen — Windows-like layout
panels-enabled=['1:0:bottom']
panels-autohide=['1:false']
panels-height=['1:48']
panel-scale-text-icons=false
panel-zone-icon-sizes='[{"panelId": 1, "left": 32, "right": 18}]'
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 20, "center": 20, "right": 16}]'
panel-zone-text-sizes='[{"panelId": 1, "left":0.0, "center":0.0, "right":0.0}]'
# Left: start menu (Cinnamenu) · Center: taskbar · Right: systray, notifications, clock
enabled-applets=['panel1:left:0:Cinnamenu@json:0', 'panel1:center:0:grouped-window-list@cinnamon.org:1', 'panel1:right:0:systray@cinnamon.org:2', 'panel1:right:1:notifications@cinnamon.org:5', 'panel1:right:2:calendar@cinnamon.org:7']
favorite-apps=@as []
app-menu-icon-name='/usr/share/pixmaps/sai-logo.png'
system-icon='/usr/share/pixmaps/sai-logo.png'

[org/cinnamon/theme]
name='Cinnamon-Delight'

[org/cinnamon/desktop/interface]
gtk-theme='Cinnamon-Delight'
icon-theme='Win11'
cursor-theme='Bibata-Modern-Classic'
font-name='Be Vietnam Pro 10'
clock-show-date=true
clock-use-24h=true

[org/cinnamon/desktop/wm/preferences]
theme='Cinnamon-Delight'

# Plain GTK/GNOME apps follow the same theme
[org/gnome/desktop/interface]
gtk-theme='Cinnamon-Delight'
icon-theme='Win11'
cursor-theme='Bibata-Modern-Classic'
font-name='Be Vietnam Pro 10'

[org/gnome/desktop/wm/preferences]
theme='Cinnamon-Delight'

# Apps pinned to the taskbar
[org/cinnamon/applets/grouped-window-list]
pinned-apps=['firefox.desktop','wps-office-prometheus.desktop','mintinstall.desktop','cinnamon-settings.desktop']
title-display=1
number-display=false
group-apps=true
